{
  "name": "BillItem",
  "type": "object",
  "properties": {
    "bill_id": {
      "type": "string"
    },
    "item_id": {
      "type": "string"
    },
    "item_name": {
      "type": "string"
    },
    "item_code": {
      "type": "string"
    },
    "huid": {
      "type": "string",
      "description": "Hallmark Unique ID snapshot at time of sale \u2014 the jewellery item's official customer-facing identification number"
    },
    "supplier_code": {
      "type": "string",
      "description": "Supplier Code (SC) snapshot at time of sale \u2014 printed in the SC column of the invoice"
    },
    "category_name": {
      "type": "string"
    },
    "metal_type": {
      "type": "string"
    },
    "purity_display": {
      "type": "string"
    },
    "purity_value": {
      "type": "number",
      "default": 0,
      "description": "Snapshot of PurityMaster.purity_value (percentage) at time of sale"
    },
    "fine_weight": {
      "type": "number",
      "default": 0,
      "description": "Per-piece fine weight = net_weight \u00d7 purity_value / 100 (snapshot at time of sale)"
    },
    "hsn": {
      "type": "string"
    },
    "quantity": {
      "type": "number"
    },
    "gross_weight": {
      "type": "number",
      "description": "Per-piece gross weight (snapshot at time of sale)"
    },
    "stone_weight": {
      "type": "number",
      "default": 0,
      "description": "Per-piece stone/less weight (snapshot at time of sale)"
    },
    "net_weight": {
      "type": "number",
      "description": "Per-piece net weight (snapshot at time of sale)"
    },
    "wastage": {
      "type": "number"
    },
    "wastage_type": {
      "type": "string",
      "enum": [
        "percentage",
        "fixed_weight"
      ],
      "description": "Wastage calculation mode. 'percentage' = wastage weight = net \u00d7 %, chargeable weight = net + wastage. 'fixed_weight' = wastage weight = entered grams. When unset, legacy mode: wastage is % of metal value as separate charge."
    },
    "wastage_weight": {
      "type": "number",
      "default": 0,
      "description": "Calculated wastage weight in grams (snapshot at time of sale)"
    },
    "chargeable_weight": {
      "type": "number",
      "default": 0,
      "description": "Net weight + wastage weight \u2014 used for metal value in silver wastage model (snapshot)"
    },
    "rate_per_gram": {
      "type": "number"
    },
    "making_charge": {
      "type": "number"
    },
    "making_charge_type": {
      "type": "string",
      "enum": [
        "percentage",
        "fixed",
        "per_gram"
      ],
      "default": "percentage"
    },
    "hallmarking_charge": {
      "type": "number",
      "default": 0,
      "description": "Per-piece hallmarking charge (snapshot)"
    },
    "discount": {
      "type": "number",
      "default": 0,
      "description": "Total line discount (snapshot)"
    },
    "gst_rate": {
      "type": "number",
      "default": 0
    },
    "metal_value": {
      "type": "number",
      "description": "Total metal value for the line (per-piece \u00d7 qty \u00d7 rate), snapshot"
    },
    "making_amount": {
      "type": "number",
      "description": "Total making amount for the line (snapshot)"
    },
    "taxable_amount": {
      "type": "number",
      "description": "Total taxable amount for the line (snapshot)"
    },
    "gst_amount": {
      "type": "number",
      "default": 0,
      "description": "Item-level GST amount (snapshot at time of sale)"
    },
    "total": {
      "type": "number",
      "description": "Total line amount including GST (snapshot)"
    }
  },
  "required": [
    "bill_id",
    "item_name",
    "quantity",
    "net_weight",
    "rate_per_gram"
  ],
  "rls": {
    "read": true,
    "create": false,
    "update": false,
    "delete": false
  }
}