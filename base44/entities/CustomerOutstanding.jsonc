{
  "name": "CustomerOutstanding",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "bill_id": {
      "type": "string"
    },
    "bill_number": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "paid",
        "partial"
      ],
      "default": "open"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "created_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "customer_id",
    "bill_id",
    "amount"
  ],
  "rls": {
    "read": true,
    "create": false,
    "update": false,
    "delete": false
  }
}