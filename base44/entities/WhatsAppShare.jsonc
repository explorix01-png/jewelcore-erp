{
  "name": "WhatsAppShare",
  "type": "object",
  "properties": {
    "bill_id": {
      "type": "string"
    },
    "bill_number": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "phone_number": {
      "type": "string"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "manual",
        "cloud_api"
      ],
      "default": "manual"
    },
    "document_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "sent",
        "failed"
      ],
      "default": "pending"
    },
    "provider_message_id": {
      "type": "string"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "error_message": {
      "type": "string"
    },
    "created_by": {
      "type": "string"
    }
  },
  "required": [
    "bill_id",
    "phone_number",
    "status"
  ],
  "rls": {
    "read": true,
    "create": false,
    "update": false,
    "delete": false
  }
}