{
  "name": "SupplierTransaction",
  "type": "object",
  "properties": {
    "supplier_id": {
      "type": "string"
    },
    "supplier_name": {
      "type": "string"
    },
    "transaction_type": {
      "type": "string",
      "enum": [
        "purchase",
        "payment",
        "adjustment"
      ]
    },
    "reference_type": {
      "type": "string"
    },
    "reference_id": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "supplier_id",
    "transaction_type",
    "amount",
    "date"
  ],
  "rls": {
    "read": true,
    "create": false,
    "update": false,
    "delete": false
  }
}