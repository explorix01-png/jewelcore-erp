{
  "name": "Customer",
  "type": "object",
  "properties": {
    "customer_code": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "mobile": {
      "type": "string"
    },
    "gst_number": {
      "type": "string"
    },
    "birth_date": {
      "type": "string",
      "format": "date"
    },
    "address": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "pincode": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "outstanding": {
      "type": "number",
      "default": 0
    },
    "is_deleted": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": true,
    "create": false,
    "update": false,
    "delete": false
  }
}